{
  "name": "canhope-steel-calculator",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build:hostinger": "NITRO_PRESET=node vite build",
    "start:hostinger": "node .output/server/index.mjs",
    "build:subdirectory": "PATH=\"$(dirname $(command -v pnpm))/../../node/bin:$PATH\" STATIC_SUBDIRECTORY_BUILD=1 pnpm exec vinext build && PATH=\"$(dirname $(command -v pnpm))/../../node/bin:$PATH\" node build/prepare-subdirectory-deploy.mjs",
    "test": "pnpm run test:build && pnpm run test:smoke && pnpm run test:subdirectory",
    "test:build": "PATH=\"$(dirname $(command -v pnpm))/../../node/bin:$PATH\" pnpm run build",
    "test:smoke": "PATH=\"$(dirname $(command -v pnpm))/../../node/bin:$PATH\" node --test tests/*.test.mjs",
    "test:subdirectory": "pnpm run build:subdirectory && PATH=\"$(dirname $(command -v pnpm))/../../node/bin:$PATH\" node --test tests/subdirectory-deploy.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern deploy --ignore-pattern .next --ignore-pattern .output",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "nitro": "3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
